# TCP port on which Relaygate listens.
PORT=4000

# Required bearer token for requests to the proxy; replace this value with a long random secret.
PROXY_TOKEN=change-me

# Maximum time in milliseconds to wait for an upstream response.
PROXY_TIMEOUT_MS=30000

# Reserved request-body limit setting; enforce a real limit at your reverse proxy for now.
PROXY_BODY_LIMIT=2mb

# Comma-separated exact upstream host allowlist; leave empty to allow public HTTPS hosts.
PROXY_ALLOWED_HOSTS=

# Optional prefix for all routes; use /api/v1 (without a trailing slash), or leave empty for root routes.
BASE_PATH=
